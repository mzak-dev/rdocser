{
  "name": "rdocser",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "serve": "vite preview --host localhost",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "build:cli": "node scripts/build-package.mjs",
    "cli": "tsx src/cli/dev.ts",
    "prepack": "npm run build:cli",
    "preview": "vite preview --host localhost",
    "test:e2e": "playwright test",
    "test:tui": "node --experimental-ffi scripts/test-tui.mjs",
    "test:package": "node scripts/test-package.mjs",
    "prepare": "npm run build:cli"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@mdx-js/rollup": "^3.1.1",
    "@opentui/core": "^0.5.14",
    "@revealjs/react": "^0.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.0",
    "@xyflow/react": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-force": "^3.0.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.52.0",
    "mdast-util-to-string": "^4.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.14.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "reveal.js": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-force": "^3.0.10",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  },
  "description": "Client-only interactive MDX documentation with a reader, document graph and isolated presentations.",
  "bin": {
    "rdocser": "./bin/rdocser.mjs"
  },
  "files": [
    "bin",
    "package-dist",
    "src",
    "index.html",
    "README.md",
    "LICENSE",
    "!src/generated",
    "!src/cli",
    "!src/package.ts",
    "!src/package.d.ts"
  ],
  "engines": {
    "node": ">=26.4.0"
  },
  "license": "MIT",
  "exports": {
    "./package.json": "./package.json",
    "./vite": {
      "import": "./package-dist/vite.mjs",
      "types": "./package-dist/vite.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "url": "git+https://github.com/mzak-dev/rdocser.git",
    "type": "git"
  },
  "homepage": "https://github.com/mzak-dev/rdocser#readme",
  "bugs": {
    "url": "https://github.com/mzak-dev/rdocser/issues"
  },
  "keywords": [
    "documentation",
    "mdx",
    "react",
    "vite",
    "opentui",
    "cli"
  ]
}
